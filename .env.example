# MongoDB configuration (primary storage)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=dispatch_monitor

# Optional — only needed if running locally against a different Node env
NODE_ENV=development

# Telegram bot credentials (optional). Used to send dispatch events to Telegram.
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Telegram webhook URL. Must be public HTTPS and end in /api/telegram/webhook.
# Leave unset for local dev; use ngrok/cloudflare tunnel or set when deployed.
# TELEGRAM_WEBHOOK_URL=https://your-host.com/api/telegram/webhook

# Local CPU Whisper service. Start it with `npm run whisper:start`.
WHISPER_SERVICE_URL=http://127.0.0.1:8178
# medium.en is the primary high-accuracy profile for one or two radio feeds.
WHISPER_MODEL=medium.en

# Optional browser override. The default is the same local service URL.
VITE_WHISPER_SERVICE_URL=http://127.0.0.1:8178

# Optional Geoapify geocoding. When configured, it is used before the existing
# Nominatim fallback. Restrict results to your response area with an optional
# bounding box: west,south,east,north.
GEOAPIFY_API_KEY=
GEOAPIFY_BOUNDING_BOX=

# Optional: Supabase migration credentials (used only by `npm run migrate:supabase`)
# Temporary: remove after migration
MIGRATION_SUPABASE_URL=https://your-project-ref.supabase.co
MIGRATION_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
