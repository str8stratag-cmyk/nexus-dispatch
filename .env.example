# Required for the app to connect to its Supabase database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional — Supabase Storage bucket for uploaded/optimized audio
# The bucket must exist and be public for audio playback URLs to work.
AUDIO_STORAGE_BUCKET=dispatch-audio

# Optional — only needed if running locally against a different Node env
NODE_ENV=development
