# MongoDB configuration (primary storage)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=str8stratag_db_user

# Optional — only needed if running locally against a different Node env
NODE_ENV=development

# Telegram bot credentials (optional). Used to send dispatch events to Telegram.
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Telegram webhook URL. Must be public HTTPS and end in /api/telegram/webhook.
# Leave unset for local dev; use ngrok/cloudflare tunnel or set when deployed.
# TELEGRAM_WEBHOOK_URL=https://your-host.com/api/telegram/webhook

# Local CPU Whisper service. Start it with `npm run whisper:start`.
WHISPER_SERVICE_URL=http://127.0.0.1:8178
# medium.en is the primary high-accuracy profile for one or two radio feeds.
WHISPER_MODEL=medium.en

# Optional browser override. The default is the same local service URL.
VITE_WHISPER_SERVICE_URL=http://127.0.0.1:8178

# Optional: shared secret protecting the local Whisper service when exposed
# via a tunnel. The server + browser send it as the X-Whisper-Key header.
# Leave unset when the service stays localhost-only.
# WHISPER_API_KEY=
# VITE_WHISPER_API_KEY=

# Optional: shared secret required by write endpoints (settings, keywords,
# telegram, dispatch). Sent as the x-admin-secret header. When unset, auth is
# disabled for local development.
# ADMIN_SECRET=

# Azure Maps geocoding (primary). 5,000 free lookups/month on Gen2.
# Create at portal.azure.com → Create resource → Azure Maps → Gen2.
# Key found in: Azure Maps account → Settings → Authentication → Primary Key.
# AZURE_MAPS_KEY=your-azure-maps-key

# Geoapify geocoding (fallback, then Nominatim). Used if Azure Maps key is unset.
# GEOAPIFY_API_KEY=
GEOAPIFY_BOUNDING_BOX=-82.8318,27.6474,-82.0545,28.1734

# Optional: suffix appended to every geocode query so generic local names like
# "Westshore", "Hyde Park", or "University Center" resolve to the right city.
# Defaults to "Tampa, FL". Set to empty to disable.
GEOCODE_SUFFIX=Tampa, FL

# Optional: Supabase migration credentials (used only by `npm run migrate:supabase`)
# Temporary: remove after migration
MIGRATION_SUPABASE_URL=https://your-project-ref.supabase.co
MIGRATION_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

