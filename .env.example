# MongoDB configuration (primary storage)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=str8stratag_db_user

# Optional — only needed if running locally against a different Node env
NODE_ENV=development

# Telegram bot credentials (optional). Used to send dispatch events to Telegram.
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id
# Comma-separated Telegram user ids allowed to use /where (driver locations).
# Get your id by messaging @userinfobot on Telegram.
# TELEGRAM_ADMIN_IDS=123456789,987654321

# Telegram webhook URL. Must be public HTTPS and end in /api/telegram/webhook.
# Leave unset on fleet desks (no public URL). Future: AWS / app.StrataG.app.
# TELEGRAM_WEBHOOK_URL=https://your-host.com/api/telegram/webhook
#
# Accept-button long-poll. Set to 1 on EXACTLY ONE desk (preferred: Disp-1) so
# that desk polls Telegram getUpdates for Accept taps and updates the shared
# board. Leave unset/0 on every other desk — two pollers fight over the bot
# (409 Conflict). Mutually exclusive with TELEGRAM_WEBHOOK_URL (webhook wins).
# TELEGRAM_ACCEPT_POLL=1

# Live-location check-in + continuous membership gate. OFF by default.
# Enable on the SAME single desk that polls (TELEGRAM_ACCEPT_POLL=1, Disp-1)
# or on the webhook host — never on more than one process. Restart that
# process after changing this so getUpdates/setWebhook subscribes to
# chat_join_request. Does not change how calls are posted to the group.
# Separate from DRIVER_LOCATION_GATE (daily check-in button).
# DRIVER_LIVE_GATE=1
# Minutes a newly approved member has to start a Live Location. Default 10.
# DRIVER_JOIN_GRACE_MIN=10
# Last live fix older than this (minutes) counts as stale. Default 15.
# DRIVER_LIVE_STALE_MIN=15
# After the one warning, minutes to re-share before removal. Default 5.
# DRIVER_RESUME_GRACE_MIN=5
# Comma-separated Telegram user ids never warned or removed. TELEGRAM_ADMIN_IDS
# are also skipped. Example only — do not commit real ids in this file's value
# if you copy it into a tracked doc.
# DRIVER_LIVE_EXEMPT_IDS=123456789

# Local CPU Whisper service. Start it with `npm run whisper:start`.
WHISPER_SERVICE_URL=http://127.0.0.1:8178
# medium.en is the primary high-accuracy profile for one or two radio feeds.
WHISPER_MODEL=medium.en

# The client (browser) and server always call this app's own /api/whisper
# proxy now, never Whisper directly -- see server/whisper-proxy.ts. Default:
# proxy to WHISPER_SERVICE_URL above. VITE_WHISPER_SERVICE_URL below is only
# an explicit escape hatch that makes the browser bypass the proxy entirely
# (old direct-call behavior; also disables failover for this desk).

# GPU/remote Whisper failover (optional; scripts/watchdog.ps1). Set this to a
# NON-local URL (anything other than 127.0.0.1/localhost/::1) to point this
# desk at a remote Whisper (e.g. the GPU box, WHISP-1). The watchdog then:
# never starts/manages local Whisper while the remote answers /health; after
# ~30s of consecutive remote failures starts local Whisper (small.en/CPU/
# int8, beam/best_of from whisper-model.local) and flips /api/whisper to it
# without a Chrome restart; switches back once the remote has been healthy
# for ~3 continuous minutes. Leave unset (or set to a 127.0.0.1/localhost
# URL) for today's always-local behavior -- nothing here changes for you.
# WHISPER_REMOTE_URL=http://192.168.6.103:8178

# Optional browser override, OFF by default so a fresh desk gets the new
# /api/whisper proxy (and failover) automatically. Setting this makes the
# browser call Whisper directly instead, bypassing the proxy (and therefore
# the failover above) for this desk -- the old pre-proxy behavior.
# VITE_WHISPER_SERVICE_URL=http://127.0.0.1:8178

# Optional Geoapify geocoding. When configured, it is used before the existing
# Nominatim fallback. Restrict results to your response area with an optional
# bounding box: west,south,east,north.
GEOAPIFY_API_KEY=
GEOAPIFY_BOUNDING_BOX=-82.8318,27.6474,-82.0545,28.1734

# Optional: Supabase migration credentials (used only by `npm run migrate:supabase`)
# Temporary: remove after migration
MIGRATION_SUPABASE_URL=https://your-project-ref.supabase.co
MIGRATION_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

